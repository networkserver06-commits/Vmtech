# LeeTec Engine production environment
# Add these variables in Vercel Project Settings -> Environment Variables.
# This template intentionally excludes Manus Forge and storage variables.
# Manus OAuth remains required by the current authentication flow.
# Never commit real secret values.

NODE_ENV=production
PORT=3000
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Session signing and Manus OAuth
JWT_SECRET=your-long-random-session-secret
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://api.manus.im
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=Platform Owner

# Safaricom Daraja / M-PESA
MPESA_ENVIRONMENT=SANDBOX
MPESA_LIVE_ENABLED=false
MPESA_CONSUMER_KEY=your-safaricom-consumer-key
MPESA_CONSUMER_SECRET=your-safaricom-consumer-secret
MPESA_PASSKEY=your-safaricom-stk-passkey
MPESA_PRODUCTION_CERTIFICATE="-----BEGIN CERTIFICATE-----\nyour-safaricom-production-certificate\n-----END CERTIFICATE-----"
LEETEC_CREDENTIAL_KEY=your-32-byte-base64-encryption-key

# Public HTTPS callback URLs
STK_CALLBACK_URL=https://leetec.online/api/v1/callbacks/stk
B2C_RESULT_URL=https://leetec.online/api/v1/callbacks/b2c/result
B2C_TIMEOUT_URL=https://leetec.online/api/v1/callbacks/b2c/timeout
C2B_CONFIRMATION_URL=https://leetec.online/api/v1/callbacks/c2b/confirmation
C2B_VALIDATION_URL=https://leetec.online/api/v1/callbacks/c2b/validation

# Vercel: set region dub1 (Ireland). Keep MPESA_LIVE_ENABLED=false until callbacks are verified.
