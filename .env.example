# LeeTec Engine — Vercel environment template
# Add each variable in Vercel Project Settings -> Environment Variables.
# Replace every placeholder; never commit real secrets.

# Runtime / current active database driver
NODE_ENV=production
# Reserved for the planned Turso/LibSQL adapter migration.
# The current runtime still reads DATABASE_URL through Drizzle/MySQL.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token
JWT_SECRET=replace-with-a-long-random-session-secret

# Comma-separated email allowlist for Super Admin access.
# Existing users with a matching email are elevated automatically on login.
ADMIN_EMAILS=admin@your-domain.com
# Safaricom Daraja / M-PESA
# Live production configuration. Set MPESA_LIVE_ENABLED=false only for a separate test deployment.
MPESA_ENVIRONMENT=PRODUCTION
MPESA_LIVE_ENABLED=true
MPESA_CONSUMER_KEY=replace-with-platform-consumer-key
MPESA_CONSUMER_SECRET=replace-with-platform-consumer-secret
MPESA_PASSKEY=replace-with-platform-stk-pass
MPESA_SHORTCODE=4208798
MPESA_PARTY_B=4770235
# AES-256-GCM key material for encrypted Daraja credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LEETEC_CREDENTIAL_KEY=replace-with-32-byte-base64-encryption-key

# Public HTTPS callback URLs
STK_CALLBACK_URL=https://leetec.online/api/v1/callbacks/stk
C2B_CONFIRMATION_URL=https://leetec.online/api/v1/callbacks/c2b/confirmation
C2B_VALIDATION_URL=https://leetec.online/api/v1/callbacks/c2b/validation

# Vercel deployment checklist
# - Add Production and Preview values separately where appropriate.
# - Set the project region to dub1 (Ireland).
# - Confirm all HTTPS callbacks are publicly reachable before enabling live money movement.
# - Use a unique LEETEC_CREDENTIAL_KEY per environment; rotating it without
#   re-encrypting stored credentials makes old credentials unreadable.
# - Adding TURSO_* alone does not switch the current active database driver.
